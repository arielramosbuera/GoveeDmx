{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noEmit": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"baseUrl": ".",
		"paths": {
			"@shared": ["../shared/src/index.ts"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
