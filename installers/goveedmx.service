[Unit]
Description=GoveeDMX Art-Net to Govee LAN bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
# Self-contained server bundle (ws + zod are bundled in).
ExecStart=__NODE__ /opt/goveedmx/server.cjs
Environment=GOVEEDMX_STATIC_DIR=/opt/goveedmx/web
Environment=GOVEEDMX_DATA_DIR=/var/lib/goveedmx
Restart=always
RestartSec=3
# Bridge listens on UDP 6454 and 4001-4003 plus the configured web TCP port.
# All default ports are above 1024, so no extra privileges are required.

[Install]
WantedBy=multi-user.target
